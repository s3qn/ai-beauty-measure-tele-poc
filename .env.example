# Copy this file to .env and fill in the values.
# Get a token from @BotFather on Telegram: https://t.me/BotFather

# Required: your Telegram bot token (never commit the real value)
TELEGRAM_BOT_TOKEN=

# Optional: logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Latency target in ms; processing_ms is logged and compared (no hard fail in POC)
TARGET_LATENCY_MS=5000

# --- Quality-gate thresholds (tune against fixtures) ---
BRIGHTNESS_MIN=50        # mean luma (0-255); below => TOO_DARK
BLUR_THRESHOLD=100       # variance of Laplacian; below => TOO_BLURRY
MIN_FACE_RATIO=0.15      # face-box width / image width; below => FACE_TOO_SMALL
MIN_RESOLUTION=200       # min(width, height) px; below => FACE_TOO_SMALL

# --- Detection model (mediapipe Tasks FaceLandmarker) ---
# Cached locally; downloaded on first run if absent. Not a user image.
# FACE_LANDMARKER_MODEL=app/assets/face_landmarker.task
# FACE_LANDMARKER_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task

# --- Data handling ---
TEMP_DIR=/tmp/beauty-bot   # only if temp files are ever needed; swept on boot
TELEMETRY_PATH=telemetry.jsonl
# Optional salt to enable a hashed (non-identifying) per-user counter. Empty = off.
CHAT_ID_SALT=

SCHEMA_VERSION=1.0.0
